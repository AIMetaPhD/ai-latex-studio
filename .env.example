# AI LaTeX Studio — copy to .env, then run scripts/up.sh (it can generate secrets).
# NEVER commit the filled-in .env.

# --- HTTP surface -------------------------------------------------------------
# Loopback only. Do not set 0.0.0.0 unless you have read docs/THREAT-MODEL.md
# and configured auth + TLS deliberately (not part of v0.1 defaults).
OVERLEAF_LISTEN_IP=127.0.0.1
OVERLEAF_PORT=8080

# --- Base images (pinned; digest asserted by scripts/up.sh) -------------------
# Default official reference; offline/restricted hosts may pull via a mirror and
# retag, as long as `docker image inspect` RepoDigests still shows the official
# sha256 recorded in docs/UPSTREAM_LOCK.md.
CE_BASE_REF=sharelatex/sharelatex:6.3.2
MONGO_IMAGE=mongo@sha256:b9924c330a8bbc5800fe9c69f04a84e221eca7b28fd049a0354147d9908fa142
REDIS_IMAGE=redis@sha256:b6b6e3dc0c0952737748e55d5d885272840c7e42ba41ab1d5489f693419882f5

# Restricted networks: the registry may be unreachable directly. These are
# TRANSPORT ONLY, never a trust root -- scripts/up.sh still verifies the official
# digests above and aborts on mismatch. Leave unset to pull direct.
#   CE_MIRROR_URL: mirror of the CE image. A tag form is fine; the pinned digest
#     is appended automatically (a full mirror ref including @sha256:... also works).
#   MIRROR_LIBRARY_URL: mirror prefix for the docker.io/library images above.
CE_MIRROR_URL=
MIRROR_LIBRARY_URL=

# --- CE internal service addressing (fixed by upstream image layout) ----------
CE_MONGO_URL=mongodb://mongo/sharelatex
CE_HISTORY_URL=http://sharelatex:3100/api

# --- Secrets ------------------------------------------------------------------
# OVERLEAF_INVITE_TOKEN_SECRET is the only secret CE demands; scripts/up.sh can
# generate it (openssl rand -base64 32). Internal CE secrets are self-generated
# by the image on first boot and persist inside the ce-data volume.
OVERLEAF_INVITE_TOKEN_SECRET=
# Guards the CE-gateway -> AI sidecar channel (openssl rand -hex 32)
AI_GATEWAY_SECRET=

# --- Local model provider (Ollama on the host) --------------------------------
# Docker Desktop: host.docker.internal reaches the host directly -> :11434.
# Native Linux / WSL Docker Engine: host.docker.internal resolves to the docker0
# gateway where nothing listens; start the loopback bridge and use :11435:
#   docker compose --profile native-bridge up -d ollama-bridge
# doctor verifies reachability from inside the sidecar container.
OLLAMA_URL=http://host.docker.internal:11434

# --- Cloud BYOK (optional; leave empty for local-only) ------------------------
# Keys live only in this file / server environment. Never in browser code,
# logs, or the CE compile container.
OPENAI_API_KEY=
COMPAT_BASE_URL=

# --- First-run admin ----------------------------------------------------------
# Address shown on the register page; also used by scripts/create-admin.sh.
# Leave empty and CE shows placeholder@example.com (doctor warns).
ADMIN_EMAIL=

# --- Local single-user convenience --------------------------------------------
# Set to 1 to open GET /ails-login password-free, signing in as the first admin.
# It only answers loopback peers (127.0.0.1/::1) and is off unless you opt in.
# For a personal, loopback-only install this removes the login prompt entirely.
# Leave 0 for any shared or network-exposed deployment.
AILS_LOCAL_AUTOLOGIN=0

# --- Compile resource ceilings ------------------------------------------------
# The compile runs inside the CE container, so these are the only ceilings a
# runaway document hits besides the wall-clock deadline. Defaults were measured
# on a 16-core / 15.5 GiB host: a normal two-page IEEE compile peaked at 66% of
# one core and 1.14 GiB for the whole container.
#   CE_CPUS=4        more/fewer cores for source compiles
#   CE_MEM_LIMIT=4g  raise this if you compile very large documents; the whole
#                    container is OOM-killed (and restarted) when it is hit
# CE_CPUS=4
# CE_MEM_LIMIT=4g
